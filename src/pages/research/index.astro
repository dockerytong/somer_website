---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="研究方向 | SOMER团队">
  <article class="research-page">
    <h1 class="sr-only">研究方向</h1>

    <div class="research-grid">
      {research.map((item, index) => (
        <section class="research-card">
          {item.data.cover && (
            <div class="research-card-cover">
              <img src={item.data.cover} alt={item.data.title} loading="lazy" />
            </div>
          )}
          <div class="research-card-content">
            <h2>
              <span class="research-num">{String(index + 1).padStart(2, '0')}</span>
              {item.data.title}
            </h2>
            <p class="research-card-summary">{item.data.summary}</p>
            <div class="research-card-footer">
              <a class="text-link" href={`/research/${item.slug}/`}>详细内容 →</a>
            </div>
          </div>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
