---
import BaseLayout from '../layouts/BaseLayout.astro';

const workflow = [
  { step: '01', title: '现场识别', text: '从矿区样地、土壤剖面和长期观测中识别真实环境问题与关键控制因子。' },
  { step: '02', title: '控制实验', text: '通过人工气候室和温室试验分离水分、植物、微生物及矿物过程的作用。' },
  { step: '03', title: '跨尺度表征', text: '连接分子组成、界面结构、微区分布与团聚体和孔隙的三维特征。' },
  { step: '04', title: '机制验证', text: '将实验认识返回野外，检验其对成土、碳稳定和生态修复的解释力。' },
];

const cards = [
  {
    number: '01',
    title: '同步辐射与先进谱学',
    summary: '解析元素价态、配位环境以及有机质与矿物相的空间耦合。',
    items: [
      ['XAFS', '解析 Fe、Al、Si 等元素的价态、配位环境与矿物相转化。'],
      ['同步辐射 FTIR mapping', '识别有机质官能团分布及其与矿物相的空间关系。'],
      ['STXM', '在微纳尺度解析有机质与矿物组分的共定位和界面结构。'],
    ],
  },
  {
    number: '02',
    title: '分子、微区与三维结构',
    summary: '从有机质分子组成延伸到元素微区分布、团聚体和孔隙结构。',
    items: [
      ['NanoSIMS', '追踪微区元素分布和有机-矿物界面的空间关联。'],
      ['FTICR-MS / Orbitrap-MS', '解析复杂环境样品中有机质的分子组成与转化特征。'],
      ['微米 CT', '重建团聚体和土壤孔隙的三维结构。'],
    ],
  },
  {
    number: '03',
    title: '控制实验与野外验证',
    summary: '以室内、温室和矿区现场的尺度递进检验过程机制。',
    items: [
      ['人工气候室', '开展温度、水分、植物和微生物控制实验。'],
      ['大型自动化温室', '开展中尺度尾矿成土、植物建植和土壤过程模拟试验。'],
      ['矿区野外试验', '开展千平米尺度的尾矿生态修复和成土过程验证。'],
      ['生态定位站合作', '支持长期观测、跨区域样地比较和野外过程验证。'],
    ],
  },
  {
    number: '04',
    title: '计算与理论',
    summary: '结合结构建模、量子化学与机器学习势计算和反应输移模型，把谱学与实验观测落到键、电荷与反应路径层面。',
    items: [
      ['结构建模与第一性原理计算', '以 ASE 建立和审核分子、slab、吸附与缺陷构型，用 VASP、ABACUS、ORCA 计算吸附能、界面电子结构与开壳层自由基体系。'],
      ['半经验与机器学习势筛选', '用 g-xTB 预筛构型，以 MACE 等机器学习势批量弛豫与排序吸附构型，把关键体系送回第一性原理计算。'],
      ['成键与波函数分析', '用 Multiwfn 做 QTAIM、键级、原子电荷、Fukui 函数与 RDG/IGMH 分析，判断界面结合方式与反应活性位点。'],
      ['反应路径与反应输移耦合', '通过过渡态搜索、功函数与晶格浸出能比较反应路径与限速步骤，并把界面参数写入反应输移模型，检验能否复现柱实验与野外观测。'],
    ],
  },
  {
    number: '05',
    title: '常规分析与合作资源',
    summary: '依托团队实验条件及长期合作资源，完成基础性质、反应组分与界面特征分析。',
    items: [
      ['红外与显微红外光谱', '表征矿物、有机质官能团及其空间分布。'],
      ['原子力显微镜与共聚焦拉曼', '分析矿物表面形貌、界面结构和微区组分。'],
      ['元素、TOC/TN 与稳定同位素分析', '定量碳、氮及水分来源与转化过程。'],
      ['液相与气相色谱', '分析小分子有机物、代谢产物及相关反应组分。'],
    ],
  },
];
---
<BaseLayout title="研究方法 | SOMER团队" description="SOMER团队的研究逻辑、实验体系与多尺度表征方法。">
  <article class="facilities-page">
    <h1 class="sr-only">研究方法</h1>

    <section class="method-workflow" aria-labelledby="workflow-title">
      <div class="method-section-heading">
        <p class="eyebrow">Research workflow</p>
        <h2 id="workflow-title">从环境问题到机制验证</h2>
      </div>
      <div class="method-workflow-grid">
        {workflow.map((item) => (
          <div class="method-step">
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="method-capabilities" aria-labelledby="capabilities-title">
      <div class="method-section-heading">
        <p class="eyebrow">Capabilities</p>
        <h2 id="capabilities-title">实验与表征能力</h2>
      </div>
      <ol class="capability-list">
        {cards.map((card) => (
          <li class="capability">
            <div class="capability-head">
              <span class="capability-index">{card.number}</span>
              <div>
                <h3>{card.title}</h3>
                <p>{card.summary}</p>
              </div>
            </div>
            <ul class="capability-items">
              {card.items.map(([name, detail]) => <li><strong>{name}</strong><span>{detail}</span></li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="method-collaboration">
      <div>
        <p class="eyebrow">Academic collaboration</p>
        <h2>面向科学问题</h2>
        <p>围绕矿物界面、元素循环、土壤形成和微生物过程，开展联合实验、多平台表征与跨区域比较。</p>
      </div>
      <div>
        <p class="eyebrow">Industry collaboration</p>
        <h2>面向现场问题</h2>
        <p>围绕矿区调查、过程诊断、技术验证、长期监测和生态修复示范，连接机制认识与工程实践。</p>
      </div>
    </section>
  </article>
</BaseLayout>
