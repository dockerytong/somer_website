---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';

const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 5);
const featuredSlugs = ['pedogenesis-mechanisms', 'interface-processes', 'organic-matter-microecology'];
const featuredResearch = (await getCollection('research'))
  .filter((item) => featuredSlugs.includes(item.slug))
  .sort((a, b) => featuredSlugs.indexOf(a.slug) - featuredSlugs.indexOf(b.slug));
---
<BaseLayout title="SOMER团队 | 土壤有机-矿物互作与生态修复">
  <section class="hero compact-hero">
    <div class="hero-copy">
      <p class="hero-label">SOMER团队</p>
      <h1>土壤有机-矿物互作与生态修复</h1>
      <p class="hero-description">
        我们研究尾矿和退化土壤中矿物、有机质与生物过程如何相互作用，重点解析矿物风化、界面反应、有机碳稳定和生态功能形成机制，并面向矿区治理与生态修复需求开展技术验证和现场研究。
      </p>
    </div>
    <aside class="hero-panel" aria-label="SOMER生态工程概念图">
      <img src="/images/docx/image2.webp" alt="SOMER生态工程概念图" width="1270" height="576" />
    </aside>
  </section>

  <section class="home-research">
    <div class="section-heading">
      <div>
        <h2>研究方向</h2>
        <p>从尾矿成土过程出发，连接矿物界面反应、有机质转化与生态功能重建。</p>
      </div>
      <a class="text-link" href="/research/">全部方向</a>
    </div>
    <div class="home-research-grid">
      {featuredResearch.map((item) => (
        <a class="home-research-card" href={`/research/${item.slug}/`}>
          {item.data.cover && <img src={item.data.cover} alt="" loading="lazy" />}
          <div>
            <h3>{item.data.title}</h3>
            <p>{item.data.summary}</p>
            <span>了解更多 →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="section-heading">
      <h2>团队动态</h2>
      <a class="text-link" href="/news/">全部动态</a>
    </div>
    <ul class="news-list-simple">
      {news.map((item) => (
        <NewsCard title={item.data.title} date={item.data.date} href={`/news/${item.slug}/`} />
      ))}
    </ul>
  </section>

  <div class="research-ethos" aria-label="研究理念">
    <span>研究理念</span>
    <p>究宇宙大地之理，创家园格局之妙。</p>
  </div>
</BaseLayout>
