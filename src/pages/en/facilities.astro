---
import BaseLayout from '../../layouts/BaseLayout.astro';

const workflow = [
  { step: '01', title: 'Identify in the field', text: 'Use mine sites, soil profiles, and long-term observations to define environmental questions and controlling factors.' },
  { step: '02', title: 'Isolate experimentally', text: 'Separate the effects of moisture, plants, microorganisms, and minerals in climate-chamber and greenhouse experiments.' },
  { step: '03', title: 'Characterize across scales', text: 'Connect molecular composition and interfacial structure with microscale distributions and three-dimensional pore architecture.' },
  { step: '04', title: 'Validate mechanisms', text: 'Return experimental insights to the field and test their explanatory power for pedogenesis, carbon stabilization, and rehabilitation.' },
];

const cards = [
  {
    number: '01', title: 'Synchrotron and Advanced Spectroscopy',
    summary: 'Resolving elemental speciation, coordination environments, and spatial coupling between organic matter and mineral phases.',
    items: [
      ['XAFS', 'Oxidation states, coordination environments, and phase transformations of Fe, Al, Si, and related elements.'],
      ['Synchrotron FTIR mapping', 'Distributions of organic functional groups and their spatial relationships with mineral phases.'],
      ['STXM', 'Micro- to nano-scale co-localization and interfacial structures of organic and mineral components.'],
    ],
  },
  {
    number: '02', title: 'Molecular, Microscale, and 3D Structure',
    summary: 'Linking organic-matter composition with microscale elemental distributions, aggregates, and pore architecture.',
    items: [
      ['NanoSIMS', 'Microscale elemental mapping and spatial analysis of organo-mineral interfaces.'],
      ['FTICR-MS / Orbitrap-MS', 'Molecular composition and transformation of complex environmental organic matter.'],
      ['Micro-CT', 'Three-dimensional reconstruction of aggregates and soil pore structures.'],
    ],
  },
  {
    number: '03', title: 'Controlled Experiments and Field Validation',
    summary: 'Testing process mechanisms across laboratory, greenhouse, and mine-site scales.',
    items: [
      ['Climate chambers', 'Controlled studies of temperature, moisture, plants, and microbial processes.'],
      ['Automated greenhouses', 'Mesocosm-scale simulations of tailing pedogenesis, plant establishment, and soil processes.'],
      ['Mine-site experiments', 'Thousand-square-meter field tests of tailing rehabilitation and pedogenesis.'],
      ['Field-station collaboration', 'Long-term observations, cross-site comparisons, and field validation.'],
    ],
  },
  {
    number: '04', title: 'Computation and Theory',
    summary: 'Combining structure modeling, quantum-chemical and machine-learning-potential calculations, and reactive transport modeling to connect spectroscopic and experimental observations to bonding, charge, and reaction pathways.',
    items: [
      ['Structure modeling and first-principles calculations', 'Building and auditing molecular, slab, adsorption, and defect structures with ASE, and computing adsorption energies, interfacial electronic structure, and open-shell radical systems with VASP, ABACUS, and ORCA.'],
      ['Semi-empirical and machine-learning-potential screening', 'Pre-screening configurations with g-xTB and using machine-learning potentials such as MACE for batch relaxation and ranking of adsorption configurations, returning key systems to first-principles calculations.'],
      ['Bonding and wavefunction analysis', 'Applying Multiwfn for QTAIM, bond-order, atomic-charge, Fukui-function, and RDG/IGMH analyses to identify interfacial binding modes and reactive sites.'],
      ['Reaction pathways and reactive transport coupling', 'Comparing reaction pathways and rate-limiting steps through transition-state searches, work functions, and lattice leaching energies, and embedding interfacial parameters into reactive transport models to test whether column experiments and field observations can be reproduced.'],
    ],
  },
  {
    number: '05', title: 'Routine Analysis and Collaborative Resources',
    summary: 'Combining team facilities and long-term shared resources for basic properties, reaction products, and interfacial features.',
    items: [
      ['Infrared and micro-FTIR', 'Mineral phases, organic functional groups, and their spatial distributions.'],
      ['AFM and confocal Raman microscopy', 'Mineral surface morphology, interfacial structures, and microscale composition.'],
      ['Elemental, TOC/TN, and stable-isotope analysis', 'Carbon and nitrogen inventories, water sources, and transformation processes.'],
      ['Liquid and gas chromatography', 'Small organic molecules, metabolites, and reaction products.'],
    ],
  },
];
---
<BaseLayout lang="en" title="Methods | SOMER Group" description="Research logic, experimental systems, and multi-scale characterization methods of the SOMER Group.">
  <article class="facilities-page">
    <h1 class="sr-only">Research Methods</h1>

    <section class="method-workflow" aria-labelledby="workflow-title">
      <div class="method-section-heading">
        <p class="eyebrow">Research workflow</p>
        <h2 id="workflow-title">From environmental questions to mechanism validation</h2>
      </div>
      <div class="method-workflow-grid">
        {workflow.map((item) => (
          <div class="method-step">
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="method-capabilities" aria-labelledby="capabilities-title">
      <div class="method-section-heading">
        <p class="eyebrow">Capabilities</p>
        <h2 id="capabilities-title">Experimental and analytical capabilities</h2>
      </div>
      <ol class="capability-list">
        {cards.map((card) => (
          <li class="capability">
            <div class="capability-head">
              <span class="capability-index">{card.number}</span>
              <div>
                <h3>{card.title}</h3>
                <p>{card.summary}</p>
              </div>
            </div>
            <ul class="capability-items">
              {card.items.map(([name, detail]) => <li><strong>{name}</strong><span>{detail}</span></li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="method-collaboration">
      <div>
        <p class="eyebrow">Academic collaboration</p>
        <h2>Questions and mechanisms</h2>
        <p>Joint experiments, multi-platform characterization, and cross-site comparisons addressing mineral interfaces, elemental cycling, soil formation, and microbial processes.</p>
      </div>
      <div>
        <p class="eyebrow">Industry collaboration</p>
        <h2>Field challenges and validation</h2>
        <p>Mine-site investigation, process diagnosis, technology validation, long-term monitoring, and rehabilitation demonstrations connecting mechanisms with practice.</p>
      </div>
    </section>
  </article>
</BaseLayout>
