---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { enNews, enResearch } from '../../data/en-site';

const news = [...enNews].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 5);
const featuredSlugs = ['pedogenesis-mechanisms', 'interface-processes', 'organic-matter-microecology'];
const featuredResearch = featuredSlugs.map((slug) => enResearch.find((item) => item.slug === slug)).filter(Boolean);
---
<BaseLayout lang="en" title="SOMER Group | Soil Organo-Mineral Interactions and Ecological Rehabilitation">
  <section class="hero compact-hero">
    <div class="hero-copy">
      <p class="hero-label">SOMER Group</p>
      <h1>Soil Organo-Mineral Interactions and Ecological Rehabilitation</h1>
      <p class="hero-description">
        We study how minerals, organic matter, and biological processes interact in mine tailings and degraded soils. Our work connects mineral weathering, interfacial reactions, carbon stabilization, and ecological function with technology validation and field research for mine-site management and rehabilitation.
      </p>
    </div>
    <aside class="hero-panel" aria-label="SOMER ecological engineering concept">
      <img src="/images/docx/image2.webp" alt="SOMER ecological engineering concept" width="1270" height="576" />
    </aside>
  </section>

  <section class="home-research">
    <div class="section-heading">
      <div>
        <h2>Research</h2>
        <p>Connecting tailing pedogenesis with mineral interfaces, organic matter transformation, and ecological function.</p>
      </div>
      <a class="text-link" href="/en/research/">All directions</a>
    </div>
    <div class="home-research-grid">
      {featuredResearch.map((item) => item && (
        <a class="home-research-card" href={`/en/research/${item.slug}/`}>
          {item.cover && <img src={item.cover} alt="" loading="lazy" />}
          <div>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <span>Learn more →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="section-heading">
      <h2>News</h2>
      <a class="text-link" href="/en/news/">All news</a>
    </div>
    <ul class="news-list-simple">
      {news.map((item) => <NewsCard title={item.title} date={item.date} href={`/en/news/${item.slug}/`} locale="en" />)}
    </ul>
  </section>

  <div class="research-ethos" aria-label="Research ethos">
    <span>Research ethos</span>
    <p>Understanding Earth processes, designing better landscapes.</p>
  </div>
</BaseLayout>
