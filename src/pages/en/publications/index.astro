---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PublicationCard from '../../../components/PublicationCard.astro';
import scholarData from '../../../data/scholar-publications.json';

const publications = scholarData.combined.filter((paper) => paper.year && paper.year >= 2023);
const years = [...new Set(publications.map((paper) => paper.year))];
const historicalPublications = scholarData.historical;
---
<BaseLayout lang="en" title="Publications | SOMER Group">
  <h1 class="sr-only">Publications</h1>
  {years.map((year) => (
    <details class="pub-year-section" open>
      <summary><h2>{year}</h2></summary>
      <ol class="bib-list">
        {publications.filter((paper) => paper.year === year).map((paper) => <PublicationCard authors={paper.authorsEn ?? paper.authors} journal={paper.journalEn ?? paper.journal} year={paper.year!} title={paper.titleEn ?? paper.title} doi={paper.doi} linkLabel="View paper" />)}
      </ol>
    </details>
  ))}
  <section class="pub-year-section">
    <h2>Publications in 2022 and earlier</h2>
    <ol class="bib-list">
      {historicalPublications.map((paper) => <PublicationCard {...paper} linkLabel="View paper" />)}
    </ol>
  </section>
</BaseLayout>
