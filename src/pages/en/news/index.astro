---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { enNews } from '../../../data/en-site';

const news = [...enNews].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const years = [...new Set(news.map((item) => item.date.getFullYear()))];
---
<BaseLayout lang="en" title="News | SOMER Group">
  <h1 class="sr-only">News</h1>
  <div class="news-archive">
    {years.map((year) => (
      <section class="news-year-section">
        <h2>{year}</h2>
        <ul class="news-list-simple">
          {news.filter((item) => item.date.getFullYear() === year).map((item) => (
            <NewsCard title={item.title} category={item.category} date={item.date} href={`/en/news/${item.slug}/`} locale="en" />
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
