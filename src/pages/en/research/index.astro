---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { enResearch } from '../../../data/en-site';
---
<BaseLayout lang="en" title="Research | SOMER Group">
  <article class="research-page">
    <h1 class="sr-only">Research</h1>

    <div class="research-grid">
      {enResearch.map((item, index) => (
        <section class="research-card">
          {item.cover && (
            <div class="research-card-cover">
              <img src={item.cover} alt={item.title} loading="lazy" />
            </div>
          )}
          <div class="research-card-content">
            <h2>
              <span class="research-num">{String(index + 1).padStart(2, '0')}</span>
              {item.title}
            </h2>
            <p class="research-card-summary">{item.summary}</p>
            <div class="research-card-footer">
              <a class="text-link" href={`/en/research/${item.slug}/`}>Details →</a>
            </div>
          </div>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
